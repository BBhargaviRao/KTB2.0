# Uncomment this line to define a global platform for your project
platform :ios, '16.0'

# CocoaPods analytics sends network stats synchronously affecting flutter build latency.
ENV['COCOAPODS_DISABLE_STATS'] = 'true'

project 'Runner', {
  'Debug' => :debug,
  'Profile' => :release,
  'Release' => :release,
}

def flutter_root
  generated_xcode_build_settings_path = File.expand_path(File.join('..', 'Flutter', 'Generated.xcconfig'), __FILE__)
  unless File.exist?(generated_xcode_build_settings_path)
    raise "#{generated_xcode_build_settings_path} must exist. If you're running pod install manually, make sure flutter pub get is executed first"
  end

  File.foreach(generated_xcode_build_settings_path) do |line|
    matches = line.match(/FLUTTER_ROOT\=(.*)/)
    return matches[1].strip if matches
  end
  raise "FLUTTER_ROOT not found in #{generated_xcode_build_settings_path}. Try deleting Generated.xcconfig, then run flutter pub get"
end

require File.expand_path(File.join('packages', 'flutter_tools', 'bin', 'podhelper'), flutter_root)

flutter_ios_podfile_setup

target 'Runner' do
  use_frameworks!

  flutter_install_all_ios_pods File.dirname(File.realpath(__FILE__))
  target 'RunnerTests' do
    inherit! :search_paths
  end
end

post_install do |installer|
  installer.pods_project.targets.each do |target|
    flutter_additional_ios_build_settings(target)
    target.build_configurations.each do |config|
      config.build_settings['ENABLE_USER_SCRIPT_SANDBOXING'] = 'NO'
    end
  end

  # Restore any missing BoringSSL-GRPC internal headers from CocoaPods cache
  # (partial install can leave these missing, causing '../asn1/internal.h' not found errors)
  cache_crypto = File.expand_path('~/Library/Caches/CocoaPods/Pods/Release/BoringSSL-GRPC')
  pods_crypto = File.join(installer.config.project_root, 'Pods/BoringSSL-GRPC/src/crypto')
  if Dir.exist?(cache_crypto) && Dir.exist?(pods_crypto)
    cache_ver = Dir.glob("#{cache_crypto}/*/src/crypto").first
    if cache_ver
      %w[asn1 bytestring bio base64 blake2 chacha des dsa ecdh_extra err lhash obj pem rc4 spx trust_token].each do |sub|
        src = "#{cache_ver}/#{sub}"
        dst = "#{pods_crypto}/#{sub}"
        FileUtils.cp_r(src, dst) if Dir.exist?(src) && !Dir.exist?(dst)
      end
      # Also restore crypto/internal.h if missing
      int_h = "#{cache_ver}/internal.h"
      FileUtils.cp(int_h, "#{pods_crypto}/internal.h") if File.exist?(int_h) && !File.exist?("#{pods_crypto}/internal.h")
    end
  end

  # Clear outputFileListPaths from CocoaPods shell script phases in Runner.xcodeproj
  # to prevent "Cycle inside Runner" build error on Xcode 15+
  runner_project = Xcodeproj::Project.open(File.expand_path('../Runner.xcodeproj', __FILE__))
  runner_project.native_targets.select { |t| t.name == 'Runner' }.each do |target|
    target.build_phases.each do |phase|
      next unless phase.is_a?(Xcodeproj::Project::Object::PBXShellScriptBuildPhase)
      next unless phase.name =~ /\[CP\] (Embed Pods Frameworks|Copy Pods Resources)/
      phase.output_file_list_paths = []
    end
  end
  runner_project.save
end
